{
  "name": "b-aide",
  "productName": "B-aide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node electron/build.mjs && electron . --dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build && node electron/build.mjs",
    "start": "electron .",
    "preview": "vite preview",
    "check-types": "tsc -b"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.3.1",
    "date-fns": "^3.3.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.2",
    "vite": "^6.4.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
